# Backend (server-side only; never use NEXT_PUBLIC_ for secrets)
AI_PROVIDER=anthropic            # anthropic | openai (optional; auto-detects from whichever key is set)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_MODEL=gpt-4o
OPSLENS_DATA_DIR=./data
RATE_LIMIT_PER_MIN=20
CORS_ORIGINS=http://localhost:3000
